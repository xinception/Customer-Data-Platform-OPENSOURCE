# =============================================================================
# Customer Data Platform - Environment Configuration
# Copy this file to .env and update values for your environment.
# =============================================================================

# Application
APP_NAME=Customer Data Platform
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://cdp:cdp_secret@localhost:5432/cdp

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication / JWT
SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI / ML
AI_MODEL_PATH=./models

# Cookie / Tracking
COOKIE_DOMAIN=localhost
COOKIE_MAX_AGE=31536000
CONSENT_REQUIRED=true

# SMTP / Email
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# AWS (optional - for S3 storage)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
